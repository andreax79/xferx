C	THIS PROGRAM CALCULATES IX FACTORIAL FOR GIVEN IX

DECIMA	FIODEC
	EXTERNAL .IO1,.IO2,.IO3,.IO4,.IO5,.IO6,.IO7,.IO8,.IO9
	EXTERNAL .IO57A,.IODEC

	CALST
	EXTERNAL EARITH
	JMS EARITH
.5,	WRITE
	JMS .IO2
	2
	FOR .100
	ENDIO

.10,	READ
	JMS .IO1
	1
	FOR .200
	ARX \IX.
	ENDIO

	LFM
	LAC (1
	DAC \IY.
	DAC \IFACT.

	LAC IX.
	SZA!CMA
	SNA
	JMP .32
	SMA
	JMP .5
	JMP .30

.30,	LFM
	LAC IY.
	CMA
	ADD IX.
	SZA!CMA
	SNA
	JMP .32
	SMA
	JMP .41
	JMP .33

.32,	WRITE
	JMS .IO2
	2
	FOR .300
	ARX IX.
	ARX IFACT.
	ENDIO

	LFM
	JMP .10

.33,	LFM
	LAC IY.
	ADD (1
	DAC \IY.
	JMS MUL
	LAC IFACT.
	DAC \IFACT.

	JMP .30

.41,	LFM
	LAC (4095	HLT

	JMP .5

	JMP .AAA
.100,	65536
	-90081
	TEXT 
 PLEASE TYPE A POSITIVE NUMBER
	-131071
	-65535

.200,	73732
	-65535

.300,	65536
	-122875
	40973
	TEXT 
 FACTORIAL IS
	8199
	-131071
	-65535

